#!/bin/bash
#SBATCH --job-name=a2mri_ev
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --gres=gpu:1
#SBATCH --partition=a40
#SBATCH --qos=a40
#SBATCH --account=vihaan
#SBATCH --mem=96G
#SBATCH --time=03:00:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_mri_eval.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_mri_eval.%j.err
#
# GENERATED by gen_sbatch_arm2_mod.py -- edit the generator, not this file. (DECISIONS.md D71)
#
# Single-modality teacher EVALUATION, MRI only (DECISIONS.md D70-D71), on an A40 exactly like
# arms 1b and 2.
#
#   sbatch arm2_mri_eval.sbatch       (after arm2_mri_train.sbatch ends FINALIZE_OK)
#
# Unchanged eval_sam.py on the merged MRI-only checkpoint, all 13,145 test instances (both
# modalities: same-modality and cross-modality groups alike) -> outputs/arm2_mri_r4, then
# aggregation, then paired comparisons with arm 1b and with the joint arm 2 (r4).
# Always resumes: resubmit the same script after a timeout.
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
CKPT=$SEG/checkpoints/sam_vit_b_01ec64.pth
RUN=$SEG/runs/arm2_mri_r4
MERGED=$SEG/checkpoints/sam_vit_b_arm2_mri_r4.pth
OUT=$SEG/outputs/arm2_mri_r4

echo "=== job ${SLURM_JOB_ID:-manual} (a2mri_ev) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any other job that writes the same files: the MRI-only training job, or another copy of this evaluation.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "a2mri_tr" || $2 == "a2mri_ev")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A40*) ;;
    *) echo "REFUSING TO START -- this job must run on an A40, got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
"$PY" "$SEG/scripts/train_sam_lora.py" --processed "$SEG/data/processed" --checkpoint "$CKPT" \
    --rank 4 --run-dir "$RUN" --merged-out "$MERGED" --modality mri --check-merged || { echo "REFUSING TO START -- merged checkpoint not verified"; exit 6; }
"$PY" -c "import torch,surface_distance,numpy,segment_anything;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
"$PY" "$SEG/scripts/eval_sam.py" \
    --processed "$SEG/data/processed" \
    --checkpoint "$MERGED" \
    --model-type vit_b \
    --out "$OUT" \
    --resume
RC=$?
echo "=== eval exit $RC"
[ "$RC" -ne 0 ] && { echo "STOPPING -- evaluation failed"; exit "$RC"; }

echo; echo "=== aggregate"
"$PY" "$SEG/scripts/aggregate_arm.py" --arm-dir "$OUT" \
    --label "Arm 2 MRI-only (r=4): SAM ViT-B fine-tuned on AMOS MRI only (LoRA q,v r=4 + decoder)"
RC=$?
echo "=== aggregate exit $RC"
[ "$RC" -ne 0 ] && { echo "STOPPING -- aggregation failed"; exit "$RC"; }
CMP_FAIL=0
echo; echo "=== compare with SAM ViT-B (arm 1b) ($SEG/outputs/arm1_vit_b)"
if [ -f "$SEG/outputs/arm1_vit_b/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm1_vit_b" --b "$OUT" \
        --label-a "SAM ViT-B (arm 1b)" --label-b "Arm 2 MRI-only r=4"
    C=$?; echo "=== compare vs arm1_vit_b exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== compare vs arm1_vit_b skipped: $SEG/outputs/arm1_vit_b/run.json not found"; CMP_FAIL=1
fi
echo; echo "=== compare with Arm 2 r=4 (joint CT+MRI teacher) ($SEG/outputs/arm2_r4)"
if [ -f "$SEG/outputs/arm2_r4/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm2_r4" --b "$OUT" \
        --label-a "Arm 2 r=4 (joint CT+MRI teacher)" --label-b "Arm 2 MRI-only r=4"
    C=$?; echo "=== compare vs arm2_r4 exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== compare vs arm2_r4 skipped: $SEG/outputs/arm2_r4/run.json not found"; CMP_FAIL=1
fi
echo
if [ "$CMP_FAIL" -ne 0 ]; then echo "=== DONE, but a comparison FAILED (see above)"; exit 5; fi
echo "=== DONE: evaluated, aggregated and compared"
exit 0
