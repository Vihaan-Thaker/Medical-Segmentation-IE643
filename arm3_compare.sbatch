#!/bin/bash
#SBATCH --job-name=arm3_cmp
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --gres=gpu:1
#SBATCH --partition=a40
#SBATCH --qos=a40
#SBATCH --account=vihaan
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm3_compare.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm3_compare.%j.err
#
# GENERATED by gen_sbatch_arm3_eval.py -- edit the generator, not this file. (DECISIONS.md D53)
#
# Arm 3 SEED SUMMARY (D53): the three plain seeds vs arm 1b and vs arm 2 r4; then the
# box student vs the plain student of the same seed (643), the D8 gap.
#
#   sbatch arm3_compare.sbatch     (after both arm3_eval scripts end DONE)
#
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
echo "=== job ${SLURM_JOB_ID:-manual} (arm3_cmp) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any job that writes the same files: an arm-3 evaluation, or another copy.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "arm3_ea" || $2 == "arm3_eb" || $2 == "arm3_cmp")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A40*) ;;
    *) echo "REFUSING TO START -- this job must run on an A40 (as every evaluation), got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
[ -f "$SEG/data/processed/manifest.csv" ] || { echo "manifest not found"; exit 2; }
"$PY" -c "import torch,surface_distance,numpy;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
CMP_FAIL=0
echo; echo "=== seed summary vs arm1_vit_b"
if [ -f "$SEG/outputs/arm1_vit_b/run.json" ]; then
    "$PY" "$SEG/scripts/seed_summary.py" --runs "$SEG/outputs/arm3_plain_s643" "$SEG/outputs/arm3_plain_s644" "$SEG/outputs/arm3_plain_s645" --ref "$SEG/outputs/arm1_vit_b" \
        --label-ref "SAM ViT-B (arm 1b)" --out "$SEG/outputs/arm3_seeds"
    C=$?; echo "=== summary vs arm1_vit_b exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== summary vs arm1_vit_b skipped: run.json not found"; CMP_FAIL=1
fi
echo; echo "=== seed summary vs arm2_r4"
if [ -f "$SEG/outputs/arm2_r4/run.json" ]; then
    "$PY" "$SEG/scripts/seed_summary.py" --runs "$SEG/outputs/arm3_plain_s643" "$SEG/outputs/arm3_plain_s644" "$SEG/outputs/arm3_plain_s645" --ref "$SEG/outputs/arm2_r4" \
        --label-ref "Arm 2 r=4 (fine-tuned teacher)" --out "$SEG/outputs/arm3_seeds"
    C=$?; echo "=== summary vs arm2_r4 exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== summary vs arm2_r4 skipped: run.json not found"; CMP_FAIL=1
fi
echo; echo "=== box s643 vs plain s643 (same seed)"
if [ -f "$SEG/outputs/arm3_box_s643/run.json" ] && [ -f "$SEG/outputs/arm3_plain_s643/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm3_plain_s643" --b "$SEG/outputs/arm3_box_s643" \
        --label-a "Arm 3 (plain, seed 643): student from scratch, no prompt" --label-b "Arm 3 (box, seed 643): student from scratch, box input"
    C=$?; echo "=== box vs plain exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== box vs plain skipped: an evaluation is missing"; CMP_FAIL=1
fi
echo
[ "$CMP_FAIL" -ne 0 ] && { echo "=== a summary or comparison FAILED or was skipped"; exit 5; }
echo "=== DONE"
exit 0
