#!/bin/bash
#SBATCH --job-name=a2mri_tr
#SBATCH -N 1
#SBATCH --ntasks-per-node=16
#SBATCH --gres=gpu:1
#SBATCH --partition=dgx
#SBATCH --qos=dgx
#SBATCH --account=vihaan
#SBATCH --mem=128G
#SBATCH --time=10:00:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_mri_train.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_mri_train.%j.err
#
# GENERATED by gen_sbatch_arm2_mod.py -- edit the generator, not this file. (DECISIONS.md D71)
#
# Single-modality teacher TRAINING, MRI only (DECISIONS.md D70-D71): SAM ViT-B + LoRA r=4
# (alpha 4, q/v of all 12 blocks) + the full mask decoder, on an A100. Arm 2's recipe on
# AMOS train MRI slices only, uniform draws, best epoch by AMOS val MRI Dice @ 10% jitter.
#
#   sbatch arm2_mri_train.sbatch
#
# Resumable (resubmit the same script after a timeout; a finished run exits TRAIN_OK at
# once). Then merges the best epoch's LoRA into a plain ViT-B checkpoint and checks the
# merge (FINALIZE_OK). The CT and MRI scripts differ ONLY in the modality and time limit.
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
CKPT=$SEG/checkpoints/sam_vit_b_01ec64.pth
RUN=$SEG/runs/arm2_mri_r4
MERGED=$SEG/checkpoints/sam_vit_b_arm2_mri_r4.pth

echo "=== job ${SLURM_JOB_ID:-manual} (a2mri_tr) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any other job that writes the same files: another copy of this training job, or the MRI-only evaluation.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "a2mri_tr" || $2 == "a2mri_ev")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A100*) ;;
    *) echo "REFUSING TO START -- this job must run on an A100, got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
[ -f "$CKPT" ] || { echo "checkpoint not found: $CKPT"; exit 2; }
"$PY" -c "import torch,surface_distance,numpy,segment_anything;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
"$PY" "$SEG/scripts/train_sam_lora.py" --processed "$SEG/data/processed" --checkpoint "$CKPT" --rank 4 --alpha 4 \
    --run-dir "$RUN" --merged-out "$MERGED" --epochs 35 --batch 8 --accum 1 \
    --lr-lora 5e-4 --lr-dec 1e-4 --seed 643 --workers 10 --expect-gpu A100 --modality mri
RC=$?
echo "=== train exit $RC"
[ "$RC" -ne 0 ] && exit "$RC"

echo; echo "=== finalize (merge + merge check)"
"$PY" "$SEG/scripts/train_sam_lora.py" --processed "$SEG/data/processed" --checkpoint "$CKPT" --rank 4 --alpha 4 \
    --run-dir "$RUN" --merged-out "$MERGED" --epochs 35 --batch 8 --accum 1 \
    --lr-lora 5e-4 --lr-dec 1e-4 --seed 643 --workers 10 --expect-gpu A100 --modality mri --finalize
FRC=$?
echo "=== finalize exit $FRC"
exit "$FRC"
