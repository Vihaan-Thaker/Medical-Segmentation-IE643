#!/bin/bash
#SBATCH --job-name=arm4_eb
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --gres=gpu:1
#SBATCH --partition=a40
#SBATCH --qos=a40
#SBATCH --account=vihaan
#SBATCH --mem=96G
#SBATCH --time=06:00:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm4_eval_b.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm4_eval_b.%j.err
#
# GENERATED by gen_sbatch_arm4_eval.py -- edit the generator, not this file. (DECISIONS.md D66)
#
# Arm 4 TEST EVALUATION (DECISIONS.md D66; ARM4_CODE_PLAN.md §11):
#   (1) distilled plain student, seed 645 -> outputs/arm4_plain_s645
#
#   sbatch arm4_eval_b.sbatch
#
# Each run: eval_student.py (resumable) -> aggregate_arm.py -> compare_arms.py vs
# arm1_vit_b, arm2_r4 and the same-seed arm-3 student. Resubmit after a timeout: finished
# evaluations are re-verified and kept. arm4_eval_a and arm4_eval_b may run together.
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
echo "=== job ${SLURM_JOB_ID:-manual} (arm4_eb) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any job that writes the same files: another copy of this script, or arm-4 training.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "arm4_eb" || $2 == "arm4_pre" || $2 == "arm4_t643" || $2 == "arm4_t644" || $2 == "arm4_t645")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A40*) ;;
    *) echo "REFUSING TO START -- this job must run on an A40 (as every evaluation), got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
[ -f "$SEG/data/processed/manifest.csv" ] || { echo "manifest not found"; exit 2; }
"$PY" -c "import torch,surface_distance,numpy;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
CMP_FAIL=0
echo; echo "=== run 1: arm 4 seed 645"
"$PY" "$SEG/scripts/eval_student.py" --processed "$SEG/data/processed" --run-dir "$SEG/runs/arm4_plain_s645" \
    --out "$SEG/outputs/arm4_plain_s645" --expect-gpu A40 --resume
RC=$?; echo "=== eval exit $RC"
[ "$RC" -ne 0 ] && { echo "STOPPING -- evaluation of arm4_plain_s645 failed"; exit "$RC"; }
"$PY" "$SEG/scripts/aggregate_arm.py" --arm-dir "$SEG/outputs/arm4_plain_s645" --label "Arm 4 (plain, seed 645): student distilled from arm 2, no prompt"
RC=$?; echo "=== aggregate exit $RC"
[ "$RC" -ne 0 ] && { echo "STOPPING -- aggregation of arm4_plain_s645 failed"; exit "$RC"; }
if [ -f "$SEG/outputs/arm1_vit_b/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm1_vit_b" --b "$SEG/outputs/arm4_plain_s645" \
        --label-a "SAM ViT-B (arm 1b)" --label-b "Arm 4 (plain, seed 645): student distilled from arm 2, no prompt"
    C=$?; echo "=== compare vs $(basename "$SEG/outputs/arm1_vit_b") exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== compare vs $(basename "$SEG/outputs/arm1_vit_b") skipped: $SEG/outputs/arm1_vit_b/run.json not found"; CMP_FAIL=1
fi
if [ -f "$SEG/outputs/arm2_r4/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm2_r4" --b "$SEG/outputs/arm4_plain_s645" \
        --label-a "Arm 2 r=4 (fine-tuned teacher)" --label-b "Arm 4 (plain, seed 645): student distilled from arm 2, no prompt"
    C=$?; echo "=== compare vs $(basename "$SEG/outputs/arm2_r4") exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== compare vs $(basename "$SEG/outputs/arm2_r4") skipped: $SEG/outputs/arm2_r4/run.json not found"; CMP_FAIL=1
fi
if [ -f "$SEG/outputs/arm3_plain_s645/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$SEG/outputs/arm3_plain_s645" --b "$SEG/outputs/arm4_plain_s645" \
        --label-a "Arm 3 (plain, seed 645): student from scratch, no prompt" --label-b "Arm 4 (plain, seed 645): student distilled from arm 2, no prompt"
    C=$?; echo "=== compare vs $(basename "$SEG/outputs/arm3_plain_s645") exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== compare vs $(basename "$SEG/outputs/arm3_plain_s645") skipped: $SEG/outputs/arm3_plain_s645/run.json not found"; CMP_FAIL=1
fi
echo
if [ "$CMP_FAIL" -ne 0 ]; then echo "=== DONE, but a comparison FAILED (see above)"; exit 5; fi
echo "=== DONE: evaluated, aggregated and compared"
exit 0
