#!/bin/bash
#SBATCH --job-name=arm4_cmp
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --gres=gpu:1
#SBATCH --partition=a40
#SBATCH --qos=a40
#SBATCH --account=vihaan
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm4_compare.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm4_compare.%j.err
#
# GENERATED by gen_sbatch_arm4_eval.py -- edit the generator, not this file. (DECISIONS.md D66)
#
# Arm 4 SEED SUMMARY (D66): the three distilled seeds vs arm 1b, vs arm 2 r4, and seed-paired
# vs the three arm-3 seeds (arm 4 seed s - arm 3 seed s), into outputs/arm4_seeds.
#
#   sbatch arm4_compare.sbatch     (after both arm4_eval scripts end DONE)
#
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
echo "=== job ${SLURM_JOB_ID:-manual} (arm4_cmp) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any job that writes the same files: an arm-4 evaluation, or another copy.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "arm4_ea" || $2 == "arm4_eb" || $2 == "arm4_cmp")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A40*) ;;
    *) echo "REFUSING TO START -- this job must run on an A40 (as every evaluation), got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
[ -f "$SEG/data/processed/manifest.csv" ] || { echo "manifest not found"; exit 2; }
"$PY" -c "import torch,surface_distance,numpy;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
CMP_FAIL=0
echo; echo "=== seed summary vs arm1_vit_b"
if [ -f "$SEG/outputs/arm1_vit_b/run.json" ]; then
    "$PY" "$SEG/scripts/seed_summary.py" --runs "$SEG/outputs/arm4_plain_s643" "$SEG/outputs/arm4_plain_s644" "$SEG/outputs/arm4_plain_s645" --ref "$SEG/outputs/arm1_vit_b" \
        --label-ref "SAM ViT-B (arm 1b)" --out "$SEG/outputs/arm4_seeds"
    C=$?; echo "=== summary vs arm1_vit_b exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== summary vs arm1_vit_b skipped: run.json not found"; CMP_FAIL=1
fi
echo; echo "=== seed summary vs arm2_r4"
if [ -f "$SEG/outputs/arm2_r4/run.json" ]; then
    "$PY" "$SEG/scripts/seed_summary.py" --runs "$SEG/outputs/arm4_plain_s643" "$SEG/outputs/arm4_plain_s644" "$SEG/outputs/arm4_plain_s645" --ref "$SEG/outputs/arm2_r4" \
        --label-ref "Arm 2 r=4 (fine-tuned teacher)" --out "$SEG/outputs/arm4_seeds"
    C=$?; echo "=== summary vs arm2_r4 exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
else
    echo "=== summary vs arm2_r4 skipped: run.json not found"; CMP_FAIL=1
fi
echo; echo "=== seed-paired summary vs the 3 arm-3 seeds (the distillation effect)"
"$PY" "$SEG/scripts/seed_summary.py" --runs "$SEG/outputs/arm4_plain_s643" "$SEG/outputs/arm4_plain_s644" "$SEG/outputs/arm4_plain_s645" --ref-runs "$SEG/outputs/arm3_plain_s643" "$SEG/outputs/arm3_plain_s644" "$SEG/outputs/arm3_plain_s645" \
    --label-ref "Arm 3 plain student" --out "$SEG/outputs/arm4_seeds"
C=$?; echo "=== summary vs arm 3 exit $C"; [ "$C" -ne 0 ] && CMP_FAIL=1
echo
[ "$CMP_FAIL" -ne 0 ] && { echo "=== a summary FAILED or was skipped"; exit 5; }
echo "=== DONE"
exit 0
