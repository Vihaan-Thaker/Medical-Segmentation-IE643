#!/bin/bash
#SBATCH --job-name=arm2_r4_ev
#SBATCH -N 1
#SBATCH --ntasks-per-node=8
#SBATCH --gres=gpu:1
#SBATCH --partition=a40
#SBATCH --qos=a40
#SBATCH --account=vihaan
#SBATCH --mem=96G
#SBATCH --time=03:00:00
#SBATCH --output=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_r4_eval.%j.out
#SBATCH --error=/home/rethinkingai-self/vihaan/Segmentation/outputs/arm2_r4_eval.%j.err
#
# GENERATED by gen_sbatch.py -- edit the generator, not this file. (DECISIONS.md D34)
#
# Arm 2 EVALUATION, rank 4, on an A40 exactly like arms 1 / 1b (DECISIONS.md D33-D34).
#
#   sbatch arm2_r4_eval.sbatch       (after arm2_select.sbatch ends SELECT_OK)
#
# Unchanged eval_sam.py on the merged checkpoint -> outputs/arm2_r4 (stamped with its sha256),
# then aggregation, then a paired comparison with arm 1b (outputs/arm1_vit_b).
# Always resumes: resubmit the same script after a timeout.
set -u
export OMP_NUM_THREADS=${SLURM_CPUS_ON_NODE:-8}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
SEG=/home/rethinkingai-self/vihaan/Segmentation
PY=/home/rethinkingai-self/vihaan/miniconda3/envs/seg311/bin/python
CKPT=$SEG/checkpoints/sam_vit_b_01ec64.pth
RUN=$SEG/runs/arm2_r4
MERGED=$SEG/checkpoints/sam_vit_b_arm2_r4.pth
OUT=$SEG/outputs/arm2_r4
SEL=$SEG/runs/arm2_selection.json
REF=$SEG/outputs/arm1_vit_b

echo "=== job ${SLURM_JOB_ID:-manual} (arm2_r4_ev) on $(hostname)"
[ -x "$PY" ] || { echo "python not found: $PY"; exit 2; }

# Refuse to run next to any other job that writes the same files: the r4 training job, another copy of this evaluation, or the selection.
if command -v squeue >/dev/null 2>&1; then
    OTHERS=$(squeue --me -h -o "%i %j %T" 2>/dev/null |
             awk -v me="${SLURM_JOB_ID:-none}" '$1 != me && ($2 == "arm2_r4_tr" || $2 == "arm2_r4_ev" || $2 == "arm2_sel")')
    if [ -n "$OTHERS" ]; then
        echo "REFUSING TO START -- these jobs write the same files:"
        echo "$OTHERS"
        echo "wait for them to finish, or scancel them, then resubmit"
        exit 3
    fi
else
    echo "warning: squeue unavailable on this node; overlap check skipped"
fi

nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
case "$GPU" in
    *A40*) ;;
    *) echo "REFUSING TO START -- this job must run on an A40, got '$GPU'"; exit 4 ;;
esac
# Prerequisites, checked only after the overlap and GPU guards (they may run python).
[ -f "$SEL" ] || { echo "REFUSING TO START -- $SEL missing: run arm2_select.sbatch first"; exit 5; }
"$PY" "$SEG/scripts/train_sam_lora.py" --processed "$SEG/data/processed" --checkpoint "$CKPT" \
    --rank 4 --run-dir "$RUN" --merged-out "$MERGED" --check-merged || { echo "REFUSING TO START -- merged checkpoint not verified"; exit 6; }
"$PY" -c "import torch,surface_distance,numpy,segment_anything;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'numpy',numpy.__version__)"
echo
"$PY" "$SEG/scripts/eval_sam.py" \
    --processed "$SEG/data/processed" \
    --checkpoint "$MERGED" \
    --model-type vit_b \
    --out "$OUT" \
    --resume
RC=$?
echo "=== eval exit $RC"
[ "$RC" -ne 0 ] && exit "$RC"

echo; echo "=== aggregate"
"$PY" "$SEG/scripts/aggregate_arm.py" --arm-dir "$OUT" \
    --label "Arm 2 (r=4): SAM ViT-B fine-tuned (LoRA q,v r=4 + decoder)"
ARC=$?
echo "=== aggregate exit $ARC"
[ "$ARC" -ne 0 ] && exit "$ARC"

echo; echo "=== compare with arm 1b, SAM ViT-B off-the-shelf ($REF)"
if [ -f "$REF/run.json" ]; then
    "$PY" "$SEG/scripts/compare_arms.py" --a "$REF" --b "$OUT" \
        --label-a "SAM ViT-B (arm 1b)" --label-b "Arm 2 r=4"
    echo "=== compare exit $? (the arm-2 results above are valid either way)"
else
    echo "=== compare skipped: $REF/run.json not found (run arm1_vitb.sbatch)"
fi
exit "$ARC"
